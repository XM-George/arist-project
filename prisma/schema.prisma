generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  SUPPORTER
}

model Sponsor {
  id            Int         @id @default(autoincrement())
  name          String
  email         String
  tier          SponsorTier
  amount        Decimal
  contactPerson String
  notes         String?
  createdAt     DateTime    @default(now())
}